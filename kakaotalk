        <!-- 채팅 항목 2 -->
        <a href="chat_mom.html" class="chat-item">
            <div class="profile-img" style="background-image: url('basic.jpg');"></div>
            <div class="chat-text">
                <div class="chat-name">엄마</div>
                <div class="chat-preview">민식아 너 또 사고쳤니?</div>
            </div>
            <div class="chat-meta">
