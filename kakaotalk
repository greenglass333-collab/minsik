<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>카카오톡 채팅목록</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #2c2c2c;
        }

        .iphone-frame {
            position: relative;
            width: 390px;
            height: 844px;
            background-color: #ffffff;
            border-radius: 50px;
            border: 8px solid #111;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* 상단 상태바 */
        .status-bar {
            display: flex;
            justify-content: space-between;
            padding: 15px 25px 10px 25px;
            color: black;
            font-size: 14px;
            font-weight: bold;
            z-index: 10;
        }
        .dynamic-island {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 35px;
            background-color: black;
            border-radius: 20px;
        }

        /* 카카오톡 헤더 (채팅 글씨 및 아이콘) */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
        }
        .header h1 {
            font-size: 24px;
            font-weight: 700;
        }
        .header-icons {
            font-size: 20px;
            color: #333;
            letter-spacing: 10px;
        }

        /* 필터 탭 (전체, 안읽음 등) */
        .filter-tabs {
            display: flex;
            padding: 0 20px 10px 20px;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: none; /* 파이어폭스 스크롤바 숨김 */
        }
        .filter-tabs::-webkit-scrollbar { display: none; } /* 크롬 스크롤바 숨김 */
        
        .tab {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            background-color: #f2f2f2;
            color: #333;
        }
        .tab.active {
            background-color: #222;
            color: white;
        }

        /* 광고 배너 */
        .ad-banner {
            margin: 0 20px 15px 20px;
            padding: 15px;
            background-color: #f9f9f9;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #eee;
        }

        /* 채팅 목록 영역 (스크롤 가능) */
        .chat-list {
            flex: 1;
            overflow-y: auto;
            padding: 0 20px;
        }
        .chat-list::-webkit-scrollbar { display: none; }

        /* 개별 채팅 항목 */
        .chat-item {
            display: flex;
            align-items: center;
            padding: 12px 0;
            text-decoration: none;
            color: black;
        }
        
        /* 프로필 이미지 */
        .profile-img {
            width: 50px;
            height: 50px;
            border-radius: 20px; /* 카카오톡 특유의 둥근 사각형 */
            background-color: #ddd;
            background-size: cover;
            background-position: center;
            margin-right: 15px;
            flex-shrink: 0;
        }

        /* 채팅 텍스트 영역 */
        .chat-text {
            flex: 1;
            overflow: hidden;
        }
        .chat-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .chat-preview {
            font-size: 13px;
            color: #888;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 시간 및 알림 배지 */
        .chat-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            margin-left: 10px;
            flex-shrink: 0;
        }
        .chat-time {
            font-size: 11px;
            color: #aaa;
            margin-bottom: 5px;
        }
        .unread-badge {
            background-color: #eb5a46;
            color: white;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 10px;
        }

        /* 하단 네비게이션 바 */
        .bottom-nav {
            display: flex;
            justify-content: space-around;
            padding: 15px 0 25px 0;
            background-color: #f9f9f9;
            border-top: 1px solid #eee;
        }
        .nav-icon {
            width: 24px;
            height: 24px;
            background-color: #ccc;
            border-radius: 5px;
        }
    </style>
</head>
<body>

<div class="iphone-frame">
    <!-- 상단 상태바 -->
