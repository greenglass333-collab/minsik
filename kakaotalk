            </div>
        </a>

        <!-- 항목을 늘리고 싶다면 위의 <a href="..."> 부터 </a> 까지 복사해서 계속 붙여넣으세요 -->

    </div>

    <!-- 하단 네비게이션 바 -->
    <div class="bottom-nav">
        <div class="nav-icon" style="border-radius: 50%;"></div> <!-- 친구 -->
        <div class="nav-icon" style="background-color: #333;"></div> <!-- 채팅 (현재위치) -->
        <div class="nav-icon"></div> <!-- 오픈채팅 -->
        <div class="nav-icon"></div> <!-- 쇼핑 -->
        <div class="nav-icon" style="background-color: transparent; font-size: 20px;">⋯</div> <!-- 더보기 -->
    </div>
</div>

